rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // Connectivity test path
    match /test/{docId} {
      allow read: if true;
    }

    // User profile documents
    match /users/{userId} {
      allow read, write: if isOwner(userId);

      // User projects subcollection
      match /projects/{projectId} {
        allow read, write: if isOwner(userId);

        // Assets subcollection within user project
        match /assets/{assetId} {
          allow read, write: if isOwner(userId);
        }
      }
    }

    // Root projects collection
    match /projects/{projectId} {
      allow read: if isSignedIn();
      allow create, update, delete: if isSignedIn() && (resource == null || resource.data.userId == request.auth.uid);
    }

    // Root assets collection
    match /assets/{assetId} {
      allow read: if isSignedIn();
      allow create, update, delete: if isSignedIn() && (resource == null || resource.data.userId == request.auth.uid);
    }

    // Default deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
